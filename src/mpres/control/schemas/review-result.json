{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "本次真实教学/审核/诊断所得，不是已通过门禁的状态声明。"
    },
    "findings": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "message",
          "slide_ids",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "severity": {
            "enum": [
              "minor",
              "major",
              "critical"
            ]
          }
        }
      },
      "minItems": 0
    },
    "feedback_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "satisfied",
              "issue",
              "not_applicable"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slide_id",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "slide_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "finding_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Reference a finding once: step:<sequence>:<1-based index> or new:<1-based index>. Scoped to this review only."
          }
        },
        "anyOf": [
          {
            "required": [
              "id",
              "version",
              "status",
              "explanation",
              "evidence"
            ]
          },
          {
            "required": [
              "id",
              "version",
              "status",
              "finding_refs"
            ],
            "properties": {
              "status": {
                "const": "issue"
              }
            }
          }
        ]
      },
      "description": "按实际请求的全部反馈 id/version 回应，引用真实页内摘录。"
    },
    "repair_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "problem_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "addressed",
              "not_found",
              "needs_decision"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "finding_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Reference a finding once: step:<sequence>:<1-based index> or new:<1-based index>. Scoped to this review only."
          }
        },
        "anyOf": [
          {
            "required": [
              "problem_id",
              "status",
              "explanation",
              "slide_ids"
            ]
          },
          {
            "required": [
              "problem_id",
              "status",
              "finding_refs"
            ],
            "properties": {
              "status": {
                "const": "needs_decision"
              }
            }
          }
        ]
      },
      "description": "确认返修的问题族检查；身份与范围来自 repair_scope。"
    },
    "finding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Reference a finding once: step:<sequence>:<1-based index> or new:<1-based index>. Scoped to this review only."
    },
    "exercise_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_slide_id",
          "status",
          "finding_index"
        ],
        "properties": {
          "question_slide_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "sufficient",
              "missing_information",
              "not_exercise"
            ]
          },
          "finding_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_exercise"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "audience_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "read_slide_ids",
        "summary",
        "observations",
        "findings"
      ],
      "properties": {
        "phase": {
          "enum": [
            "student",
            "production_language"
          ]
        },
        "read_slide_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "observations": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slide_id",
              "quote",
              "learning_impact"
            ],
            "properties": {
              "slide_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "learning_impact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "required": [
              "message",
              "slide_ids",
              "severity"
            ],
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              },
              "slide_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "severity": {
                "enum": [
                  "minor",
                  "major",
                  "critical"
                ]
              }
            }
          },
          "minItems": 0,
          "maxItems": 24
        },
        "attention_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "disposition",
              "learning_loss_if_removed",
              "reason",
              "finding_index"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "keep",
                  "remove",
                  "rewrite",
                  "move_to_notes"
                ]
              },
              "learning_loss_if_removed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "finding_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "exercise_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_slide_id",
              "status",
              "finding_index"
            ],
            "properties": {
              "question_slide_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "sufficient",
                  "missing_information",
                  "not_exercise"
                ]
              },
              "finding_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not_exercise"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  },
  "description": "单一通道的首次审核结果；不改源稿，不把作者处置当独立验证。"
}
