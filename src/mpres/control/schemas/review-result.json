{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "message",
          "slide_ids",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "severity": {
            "enum": [
              "minor",
              "major",
              "critical"
            ]
          }
        }
      },
      "minItems": 0
    },
    "feedback_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "status",
          "explanation",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "satisfied",
              "issue",
              "not_applicable"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slide_id",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "slide_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "repair_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "problem_id",
          "status",
          "explanation",
          "slide_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "problem_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "addressed",
              "not_found",
              "needs_decision"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
