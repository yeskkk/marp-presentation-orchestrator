{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "本次真实教学/审核/诊断所得，不是已通过门禁的状态声明。"
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "status",
          "explanation"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "addressed",
              "needs_decision"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "description": "仅本轮 finding 修订需要；作者说明相关修改与复算，不是 reviewer 验修。"
    },
    "teaching_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "description": "教师/制作者说明留内部，不投影到学生页。"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "description": "具体资料、范围或语义待决；不要用自证页面掩盖缺口。"
    },
    "feedback_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "status",
          "explanation",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "satisfied",
              "issue",
              "not_applicable"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slide_id",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "slide_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "description": "按实际请求的全部反馈 id/version 回应，引用真实页内摘录。"
    },
    "repair_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "problem_id",
          "status",
          "explanation",
          "slide_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "problem_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "addressed",
              "not_found",
              "needs_decision"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "description": "确认返修的问题族检查；身份与范围来自 repair_scope。"
    },
    "slide_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "action",
          "target_slide_id",
          "reason"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "delete",
              "merge"
            ]
          },
          "target_slide_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "仅获准删/并时提供，累计对应原返修稿；保留页不重命名。"
    }
  },
  "description": "作者语义结果。真实条件义务来自请求；状态/回执/源码路径不在此对象内。"
}
