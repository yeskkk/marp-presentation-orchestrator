{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "status",
          "explanation"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "addressed",
              "needs_decision"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "teaching_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
