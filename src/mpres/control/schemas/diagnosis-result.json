{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "summary",
    "hypotheses",
    "confidence",
    "affected_slide_ids",
    "recommended_action"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "explanation",
          "slide_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "affected_slide_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "recommended_action": {
      "enum": [
        "no_change",
        "scoped_revision",
        "more_evidence",
        "full_review"
      ]
    },
    "feedback_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "status",
          "explanation",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "satisfied",
              "issue",
              "not_applicable"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slide_id",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "slide_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "expansion": {
      "type": "object",
      "required": [
        "problem_definition",
        "variants",
        "related_problems",
        "non_goals",
        "acceptance_criteria",
        "source_needs"
      ],
      "additionalProperties": false,
      "properties": {
        "problem_definition": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "detection",
              "correction",
              "evidence_status",
              "slide_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "detection": {
                "type": "string",
                "minLength": 1
              },
              "correction": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "possible",
                  "observed"
                ]
              },
              "slide_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "related_problems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "detection",
              "correction",
              "evidence_status",
              "slide_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "detection": {
                "type": "string",
                "minLength": 1
              },
              "correction": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "possible",
                  "observed"
                ]
              },
              "slide_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_needs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
