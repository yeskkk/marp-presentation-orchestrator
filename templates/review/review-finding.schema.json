{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mpres full-review finding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "channel",
    "round_opened",
    "location",
    "issue",
    "learner_impact",
    "acceptance_criteria",
    "verification_method"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "channel": {
      "enum": ["language", "domain_accuracy", "layout", "pedagogy", "audience"]
    },
    "round_opened": {"const": "full"},
    "location": {"type": "object"},
    "issue": {"type": "string", "minLength": 1},
    "learner_impact": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "string", "minLength": 1},
    "verification_method": {"type": "string", "minLength": 1},
    "author_response": {"type": ["object", "null"]}
  }
}
